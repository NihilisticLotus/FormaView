{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143,version=14.44.35207",
      "binaryDir": "${sourceDir}/out/msvc",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
        "CMAKE_PREFIX_PATH": "$env{FORMAVIEW_QT_ROOT}",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-msvc-full",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/out/msvc-full",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "notEquals", "lhs": "$env{FORMAVIEW_QT_ROOT}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{FORMAVIEW_UFBX_ROOT}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{FORMAVIEW_CGLTF_ROOT}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{FORMAVIEW_FBXSDK_ROOT}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{FORMAVIEW_DEPENDENCY_PREFIX_PATH}", "rhs": "" }
        ]
      },
      "cacheVariables": {
        "FORMAVIEW_BUILD_HOST": "ON",
        "FORMAVIEW_BUILD_PROFESSIONAL": "ON",
        "FORMAVIEW_BUILD_RASTER": "ON",
        "FORMAVIEW_BUILD_FBX_WRITER": "ON",
        "FORMAVIEW_UFBX_ROOT": "$env{FORMAVIEW_UFBX_ROOT}",
        "FORMAVIEW_CGLTF_ROOT": "$env{FORMAVIEW_CGLTF_ROOT}",
        "FORMAVIEW_FBXSDK_ROOT": "$env{FORMAVIEW_FBXSDK_ROOT}",
        "CMAKE_PREFIX_PATH": "$env{FORMAVIEW_QT_ROOT};$env{FORMAVIEW_DEPENDENCY_PREFIX_PATH}"
      }
    },
    {
      "name": "windows-asan",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/out/asan",
      "cacheVariables": { "FORMAVIEW_BUILD_HOST": "OFF", "FORMAVIEW_ASAN": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "release-full", "configurePreset": "windows-msvc-full", "configuration": "Release" },
    { "name": "asan", "configurePreset": "windows-asan", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "release-full", "configurePreset": "windows-msvc-full", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "asan", "configurePreset": "windows-asan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
