option(FORMAVIEW_BUILD_RASTER "Build CPU raster image adapters (no GUI required)" OFF)
if(FORMAVIEW_BUILD_RASTER)
    find_package(Qt6 6.12.0 EXACT REQUIRED COMPONENTS Gui)
    find_package(ZLIB 1.3.2 EXACT CONFIG REQUIRED COMPONENTS static)
    if(NOT TARGET ZLIB::ZLIB)
        add_library(ZLIB::ZLIB ALIAS ZLIB::ZLIBSTATIC)
    endif()
    find_package(TIFF 4.7.2 EXACT REQUIRED)
    find_package(WebP 1.6.0 EXACT CONFIG REQUIRED)
    add_library(formaview_raster STATIC src/formats/raster_image.cpp src/formats/extended_raster.cpp)
    add_library(FormaView::Raster ALIAS formaview_raster)
    target_link_libraries(formaview_raster PUBLIC FormaView::Core PRIVATE Qt6::Gui TIFF::TIFF WebP::webp WebP::webpdemux WebP::libwebpmux formaview_options)
endif()
