# Dependencies remain outside the source tree. No SDK download or installation.
set(FORMAVIEW_UFBX_ROOT "" CACHE PATH "External ufbx 0.23.1 source directory")
set(FORMAVIEW_FBXSDK_ROOT "" CACHE PATH "Locally licensed Autodesk FBX SDK 2020.2")
option(FORMAVIEW_BUILD_FBX_WRITER "Build the optional local FBX SDK writer" OFF)
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json" formaview_dependency_lock)
if(FORMAVIEW_UFBX_ROOT)
    foreach(name IN ITEMS ufbx.c ufbx.h LICENSE)
        string(JSON expected GET "${formaview_dependency_lock}" ufbx sources_sha256 "${name}")
        file(SHA256 "${FORMAVIEW_UFBX_ROOT}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "ufbx dependency checksum mismatch: ${name}")
        endif()
    endforeach()
    add_library(formaview_ufbx STATIC "${FORMAVIEW_UFBX_ROOT}/ufbx.c")
    if(FORMAVIEW_ASAN)
        if(MSVC)
            target_compile_options(formaview_ufbx PRIVATE /fsanitize=address /Zi)
        else()
            target_compile_options(formaview_ufbx PRIVATE -fsanitize=address -fno-omit-frame-pointer)
        endif()
    endif()
    if(FORMAVIEW_UBSAN)
        target_compile_options(formaview_ufbx PRIVATE ${formaview_ubsan_compile_options})
    endif()
    set_source_files_properties("${FORMAVIEW_UFBX_ROOT}/ufbx.c" PROPERTIES LANGUAGE CXX)
    target_include_directories(formaview_ufbx SYSTEM PUBLIC "${FORMAVIEW_UFBX_ROOT}")
    add_library(formaview_fbx STATIC src/formats/fbx_read.cpp)
    target_link_libraries(formaview_fbx PUBLIC FormaView::Core PRIVATE formaview_ufbx formaview_options)
    add_library(FormaView::Fbx ALIAS formaview_fbx)
endif()
if(FORMAVIEW_BUILD_FBX_WRITER)
    if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "Local FBX SDK writer is currently validated only with MSVC x64")
    endif()
    if(NOT FORMAVIEW_FBXSDK_ROOT)
        message(FATAL_ERROR "Provide the external, locally licensed FBX SDK 2020.2 root")
    endif()
    file(STRINGS "${FORMAVIEW_FBXSDK_ROOT}/include/fbxsdk/fbxsdk_version.h" sdk_point REGEX "^#define FBXSDK_VERSION_POINT +0 ")
    file(STRINGS "${FORMAVIEW_FBXSDK_ROOT}/include/fbxsdk/fbxsdk_version.h" sdk_minor REGEX "^#define FBXSDK_VERSION_MINOR +2 ")
    file(STRINGS "${FORMAVIEW_FBXSDK_ROOT}/include/fbxsdk/fbxsdk_version.h" sdk_major REGEX "^#define FBXSDK_VERSION_MAJOR +2020 ")
    if(NOT sdk_point OR NOT sdk_minor OR NOT sdk_major)
        message(FATAL_ERROR "Expected FBX SDK 2020.2.0; validate a different version separately")
    endif()
    add_library(formaview_fbx_writer STATIC src/formats/fbx_write.cpp)
    add_library(FormaView::FbxWriter ALIAS formaview_fbx_writer)
    target_include_directories(formaview_fbx_writer SYSTEM PRIVATE "${FORMAVIEW_FBXSDK_ROOT}/include")
    target_link_libraries(formaview_fbx_writer PUBLIC FormaView::Core PRIVATE formaview_options)
    foreach(lib IN ITEMS libfbxsdk-md libxml2-md zlib-md)
        string(JSON expected GET "${formaview_dependency_lock}" fbx_sdk validation_library_sha256 "${lib}.lib")
        file(SHA256 "${FORMAVIEW_FBXSDK_ROOT}/lib/vs2017/x64/release/${lib}.lib" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "FBX SDK release library checksum differs from the validated local candidate: ${lib}")
        endif()
        target_link_libraries(formaview_fbx_writer PRIVATE
            optimized "${FORMAVIEW_FBXSDK_ROOT}/lib/vs2017/x64/release/${lib}.lib"
            debug "${FORMAVIEW_FBXSDK_ROOT}/lib/vs2017/x64/debug/${lib}.lib")
    endforeach()
    target_link_libraries(formaview_fbx_writer PRIVATE wininet ws2_32)
endif()
