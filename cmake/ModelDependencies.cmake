set(FORMAVIEW_CGLTF_ROOT "" CACHE PATH "External pinned cgltf 1.15 source directory")
if(FORMAVIEW_CGLTF_ROOT)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json" model_dependency_lock)
    foreach(name IN ITEMS cgltf.h LICENSE)
        string(JSON expected GET "${model_dependency_lock}" cgltf sources_sha256 "${name}")
        file(SHA256 "${FORMAVIEW_CGLTF_ROOT}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "cgltf dependency checksum mismatch: ${name}")
        endif()
    endforeach()
    add_library(formaview_cgltf STATIC src/formats/cgltf_impl.cpp src/formats/gltf_anim.cpp)
    target_link_libraries(formaview_cgltf PUBLIC FormaView::Core)
    target_include_directories(formaview_cgltf SYSTEM PUBLIC "${FORMAVIEW_CGLTF_ROOT}")
    if(FORMAVIEW_ASAN AND MSVC)
        target_compile_options(formaview_cgltf PRIVATE /fsanitize=address /Zi)
    elseif(FORMAVIEW_ASAN)
        target_compile_options(formaview_cgltf PRIVATE -fsanitize=address -fno-omit-frame-pointer)
    endif()
    if(FORMAVIEW_UBSAN)
        target_compile_options(formaview_cgltf PRIVATE ${formaview_ubsan_compile_options})
    endif()
endif()
