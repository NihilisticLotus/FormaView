if(TARGET formaview_raster AND TARGET formaview_professional)
    add_library(formaview_image_conversion STATIC src/formats/image_conversion.cpp)
    add_library(FormaView::ImageConversion ALIAS formaview_image_conversion)
    target_link_libraries(formaview_image_conversion PUBLIC FormaView::Professional FormaView::Raster PRIVATE Qt6::Core Qt6::Gui formaview_options)
    if(WIN32)
        find_package(Qt6 6.12.0 EXACT REQUIRED COMPONENTS Network)
        target_sources(formaview_image_conversion PRIVATE src/formats/image_requests.cpp src/service/image_batch.cpp src/service/image_groups.cpp src/service/image_endpoint.cpp)
        target_link_libraries(formaview_image_conversion PUBLIC Qt6::Core Qt6::Network)
        if(TARGET formaview_fbx_writer)
            target_sources(formaview_image_conversion PRIVATE src/formats/model_export.cpp src/formats/scene_export.cpp src/formats/fbx_selection.cpp src/formats/scene_obj.cpp src/formats/scene_pmx.cpp src/formats/scene_abc.cpp)
            target_include_directories(formaview_image_conversion SYSTEM PRIVATE "${FORMAVIEW_FBXSDK_ROOT}/include")
            if(TARGET formaview_cgltf)
                target_sources(formaview_image_conversion PRIVATE src/formats/scene_gltf.cpp src/formats/scene_gltf_animation.cpp)
                target_link_libraries(formaview_image_conversion PRIVATE formaview_gltf_anim)
                target_compile_definitions(formaview_image_conversion PRIVATE FORMAVIEW_GLTF_EXPORT=1)
            endif()
            target_link_libraries(formaview_image_conversion PRIVATE FormaView::FbxWriter)
            target_compile_definitions(formaview_image_conversion PUBLIC FORMAVIEW_MODEL_EXPORT=1)
        endif()
        add_executable(formaview_image_cli src/service/image_cli.cpp)
        formaview_add_windows_version(formaview_image_cli)
        target_link_libraries(formaview_image_cli PRIVATE FormaView::ImageConversion Qt6::Network formaview_options)
        add_executable(formaview_image_service src/service/image_service.cpp)
        formaview_add_windows_version(formaview_image_service)
        target_link_libraries(formaview_image_service PRIVATE FormaView::ImageConversion Qt6::Network formaview_options)
    endif()
endif()
